# =========================
# Chatbot Dataset - versão apenas em português
# =========================
from chatterbot import ChatBot
from chatterbot.trainers import ListTrainer

# Criar o chatbot
chatbot_dataset = ChatBot("Dataset Bot", read_only=True)
dataset_trainer = ListTrainer(chatbot_dataset)

# Exemplo de diálogos em português (substituindo DailyDialog)
dialogs_pt = [
    ["Oi!", "Olá! Como você está?"],
    ["Estou bem, e você?", "Também estou bem, obrigado!"],
    ["Qual é o seu nome?", "Eu sou o Dataset Bot."],
    ["O que você gosta de fazer?", "Gosto de conversar e aprender coisas novas."],
    ["Você gosta de música?", "Sim! Qual é o seu estilo favorito?"],
    ["Eu gosto de rock.", "Que legal! Rock é ótimo."],
    ["Adeus", "Até mais! Tenha um bom dia!"]
]

# Treinar o chatbot com pares consecutivos
for dialog in dialogs_pt:
    for i in range(len(dialog)-1):
        dataset_trainer.train([dialog[i], dialog[i+1]])

print("=== Chat interativo Dataset Bot (Português) ===")
print("Digite 'sair' para encerrar o chat.")

# Loop de conversa interativo
while True:
    pergunta = input("Você: ")
    if pergunta.lower() in ["sair", "exit", "quit"]:
        print("Chat encerrado. Até mais!")
        break
    resposta = chatbot_dataset.get_response(pergunta)
    print("Bot:", resposta)

